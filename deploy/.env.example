# 复制为 .env 并修改后再 docker compose up -d

# 信令服务公网地址（必须所有参与者都能访问，https:// 开头）
PUBLIC_ORIGIN=https://share.example.com

# TURN 服务器公网地址（对应 coturn 的 3478，逗号分隔）
TURN_URLS=turn:share.example.com:3478

# 与 turnserver.conf 的 static-auth-secret 完全一致
TURN_SHARED_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# 或改用静态凭证（成对提供，优先于上面的 HMAC 短期凭证）
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-password

# 可选：STUN 列表（默认 Google 公共 STUN）
# STUN_URLS=stun:stun.l.google.com:19302

# 可选：全局观众上限（建房时可选 1~4）
# MAX_VIEWERS=4
